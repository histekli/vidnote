# VidNote ayarları. Bu dosyayı ayarlar.env adıyla kopyala (kur.sh bunu yapar).

# Konuşma dili (tr, en ...). Boş bırakırsan otomatik algılanır.
LANGUAGE=tr

# Konuşma modeli. large-v3-turbo Türkçede iyi; daha hızlısı için small (kalite düşer).
WHISPER_MODEL=large-v3-turbo
# NVIDIA ekran kartın ve CUDA kuruluysa: cuda
WHISPER_DEVICE=cpu

# Ekrandaki tüm yazılar için tarama aralığı (saniye). 0 = kapalı (çok daha hızlı, ama altyazı akışı çıkmaz).
TEXT_SCAN=1

# Dökümlerin saklandığı klasör
NOTES_DIR=~/VidNote

# Tarayıcı sayfası. Uzaktan erişim için HOST=0.0.0.0 yerine SSH tüneli kullanman önerilir (README'ye bak).
HOST=127.0.0.1
PORT=8765

# Linkten işlerken yorumları da al (en fazla bu kadar). 0 = alma. Bazı sitelerde işlemi yavaşlatır.
# Instagram yorumları için tarayıcı eklentisini kullanmak daha güvenilirdir.
LINK_COMMENTS=0

# Giriş isteyen siteler (Instagram gibi) için çerezler. İkisinden biri:
#   COOKIES_BROWSER: bu makinede giriş yapılmış tarayıcı (chrome, firefox, safari). Mac'te en kolayı budur.
#   COOKIES_FILE: tarayıcından dışa aktardığın cookies.txt dosyasının yolu (ekransız sunucu için)
COOKIES_FILE=
COOKIES_BROWSER=

# İsteğe bağlı: kendi Telegram botun. Hermes kullanıyorsan boş bırak;
# Hermes'in kullandığı bot anahtarını buraya YAZMA, ikisi çakışır.
TELEGRAM_TOKEN=
TELEGRAM_USERS=
